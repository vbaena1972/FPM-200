/firmware/managed_components/

# ===== Logs y trazas =====
/logs/
*.svdat
*.log
log*.txt
firmware/log*.txt

# ===== Editor / SO =====
.vscode/ipch/
*.tmp
Thumbs.db
.DS_Store

# ===== Scratch / trabajo temporal =====
/tmp/
sw_probe*.vbs

# Nota: sdkconfig SÍ se versiona (contiene ajustes del proyecto).
# sdkconfig.defaults es la fuente de verdad y también se versiona.

# ===== Configuración local de Claude =====
/.claude/settings.local.json

# ===== Graphify =====
# Solo se sincronizan los cuatro resultados útiles.
/graphify-out/*

!/graphify-out/graph.json
!/graphify-out/graph.html
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/manifest.json
# ===== Credenciales AWS IoT locales =====
# Nunca versionar certificados ni claves privadas de dispositivos.
/aws/

